APP_NAME="Baradox's stuff"
APP_ENV=local
# Generate with: ./vendor/bin/sail artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Sail serves the app with PHP's built-in server. With a single worker, one long
# audio/video stream blocks every other request, so keep several.
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL runs in the Sail "mysql" container. compose.yaml reads these same values to
# create the database and user on first start, so pick them before the first `sail up`.
# Don't use "root" as DB_USERNAME: the MySQL image refuses it as a regular user.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail is unused by the app; Sail's Mailpit container catches anything sent.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Port of the Vite dev server, which runs INSIDE the laravel.test container
# (./vendor/bin/sail npm run dev). compose.yaml reads it to publish the port and
# vite.config.js reads it for the listener, so the two always agree. Set it
# explicitly: compose.yaml falls back to 5173 but vite.config.js falls back to 5299.
# 5299 is used because Windows/Hyper-V can reserve port ranges that include 5173;
# any free port works.
VITE_PORT=5299

# Sail ships a Meilisearch container; the app does not use it.
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_NO_ANALYTICS=false
MEILISEARCH_UPGRADE_DB=true

# Read ONLY by database/seeders/DatabaseSeeder.php (`sail artisan db:seed`), which
# creates the two accounts. Fill all four before seeding, or create the accounts by
# hand instead (see README, "Create the two accounts"). Passwords are hashed on
# save; nothing here is used after seeding, so they can be blanked again afterwards.
# Left commented on purpose: blank values would seed accounts with empty usernames,
# while unset ones make db:seed fail loudly. Uncomment and fill them in to seed.
# ADMIN_* is your own account. PREVIEW_* is the Guest account (is_preview = true);
# the login page's Guest button signs into it without its password.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# PREVIEW_USERNAME=
# PREVIEW_PASSWORD=
